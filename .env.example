# Copy to .env to override docker-compose defaults.

# cpu (default, works everywhere) or gpu (needs an NVIDIA GPU +
# nvidia-container-toolkit on the host — see docker-compose.yml).
# TORCH_VARIANT=cpu

# Enables voice cloning — see backend/.env.example for how to get one.
# HF_TOKEN=hf_xxx

# Must match wherever the frontend is actually reachable from the browser.
# FRONTEND_ORIGIN=http://localhost:8080

# Must match wherever the API is actually reachable from the browser —
# baked into the frontend at build time, not read at runtime.
# VITE_API_URL=http://localhost:8000
